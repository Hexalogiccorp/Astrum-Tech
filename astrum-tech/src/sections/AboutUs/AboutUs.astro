---
import BaseButton from "../../components/BaseButton/BaseButton.astro";
import Title from "../../components/Reusables/title/title.astro";
import "./AboutStyle.css";
---

<section id="about-us" class="grid grid-cols-1 gap-12 items-center max-w-[1800px] mx-auto px-[clamp(1.25rem,4vw,3rem)] my-16 lg:my-32 min-[901px]:grid-cols-[0.85fr_1.15fr] min-[901px]:min-h-162.5">
  <div class="left-side h-[440px] min-[901px]:h-full">
    <div class="left-frame relative h-full">
      <img
        class="main-photo absolute left-0 top-0 w-[58%] h-full object-cover"
        src="/aboutUsImg1.webp"
        alt="Técnico operando equipo de perforación"
      />

      <div class="stat-box absolute right-0 top-0 w-[39%] h-[46%] flex flex-col justify-center items-center text-center gap-4 p-4 overflow-hidden">
        <div class="stat-top flex flex-col items-center gap-2">
          <span class="stat-number">3+</span>
          <p class="stat-text">
            Lorem Ipsum dolor sit ammet surtur asator irtir surtur asator
            Lorem Ipsum
          </p>
        </div>
        <svg
          class="stat-hook absolute bottom-0 left-5"
          width="15"
          height="29"
          viewBox="0 0 15 29"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M4.37109 7.52344H10.3359V0.0302734C12.8733 1.17966 14.6395 3.73249 14.6396 6.69922C14.6396 10.0354 12.4067 12.8484 9.35449 13.7305V27.3662C9.35449 27.9185 8.90678 28.3662 8.35449 28.3662H6.33105C5.77877 28.3662 5.33105 27.9185 5.33105 27.3662V13.7432C2.2552 12.8764 0 10.0523 0 6.69922C0.000170966 3.70607 1.79738 1.1343 4.37109 0V7.52344Z"
            fill="black"
            fill-opacity="0.38"
          ></path>
        </svg>
      </div>

      <img
        class="overlap-photo absolute right-0 bottom-0 w-[39%] h-[51%] object-cover z-[1] min-[901px]:w-[58%] min-[901px]:h-[55%] min-[901px]:left-auto"
        src="/aboutUsImg2.webp"
        alt="Excavadora trabajando en obra"
      />
    </div>
  </div>

  <div class="rigth-side h-full flex flex-col items-start justify-between">
    <Title text="ABOUT US"/>
     <h2 class="about-title mt-5">WHY CHOOSE ASTRUM TECH?</h2>
    <div class="about-content flex flex-col gap-2 mt-5">


    <p class="about-paragraph paragraph">
      Lorem Ipsum dolor sit ammet surtur asator irtir surtur asator Lorem Ipsum
      dolor Lorem Ipsum dolor sit .
    </p>
    <p class="about-define mt-2 mb-5">What define us?</p>
    <ul class="about-list flex flex-col gap-[0.85rem]">
        <li class="flex gap-3 items-center"><svg class="shrink-0" width="22" height="21" viewBox="0 0 22 21" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M22 10.5L19.56 7.71L19.9 4.02L16.29 3.2L14.4 0L11 1.46L7.6 0L5.71 3.19L2.1 4L2.44 7.7L0 10.5L2.44 13.29L2.1 16.99L5.71 17.81L7.6 21L11 19.53L14.4 20.99L16.29 17.8L19.9 16.98L19.56 13.29L22 10.5ZM9.09 15.22L5.29 11.41L6.77 9.93L9.09 12.26L14.94 6.39L16.42 7.87L9.09 15.22Z" fill="#0898FF"/>
</svg>
 <span>{"Sinergia Única entre Precisión y Fuerza".split(" ").map((word, i) => (
          <>
            <span class="word-mask"><span style={`--i:${i}`}>{word}</span></span>{" "}
          </>
        ))}</span></li>
        <li class="flex gap-3 items-center"><svg class="shrink-0" width="22" height="21" viewBox="0 0 22 21" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M22 10.5L19.56 7.71L19.9 4.02L16.29 3.2L14.4 0L11 1.46L7.6 0L5.71 3.19L2.1 4L2.44 7.7L0 10.5L2.44 13.29L2.1 16.99L5.71 17.81L7.6 21L11 19.53L14.4 20.99L16.29 17.8L19.9 16.98L19.56 13.29L22 10.5ZM9.09 15.22L5.29 11.41L6.77 9.93L9.09 12.26L14.94 6.39L16.42 7.87L9.09 15.22Z" fill="#0898FF"/>
</svg>
<span>{"Calidad de Suministros a la Medida".split(" ").map((word, i) => (
          <>
            <span class="word-mask"><span style={`--i:${i}`}>{word}</span></span>{" "}
          </>
        ))}</span></li>
        <li class="flex gap-3 items-center"><svg class="shrink-0" width="22" height="21" viewBox="0 0 22 21" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M22 10.5L19.56 7.71L19.9 4.02L16.29 3.2L14.4 0L11 1.46L7.6 0L5.71 3.19L2.1 4L2.44 7.7L0 10.5L2.44 13.29L2.1 16.99L5.71 17.81L7.6 21L11 19.53L14.4 20.99L16.29 17.8L19.9 16.98L19.56 13.29L22 10.5ZM9.09 15.22L5.29 11.41L6.77 9.93L9.09 12.26L14.94 6.39L16.42 7.87L9.09 15.22Z" fill="#0898FF"/>
</svg>
<span>{'Compromiso de "Cero Tiempo Muerto" (Velocidad de Respuesta)'.split(" ").map((word, i) => (
          <>
            <span class="word-mask"><span style={`--i:${i}`}>{word}</span></span>{" "}
          </>
        ))}</span></li>
    </ul>
    </div>
   

    <BaseButton variant="secondary" class="about-button mt-4">About us <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
</svg>
</BaseButton>
  </div>
</section>

<script src="./AboutUs.ts"></script>
