---
import "./Navbar.css";
---

<header class="navbar">
  <div class="container">
    <nav class="nav">
      <div class="nav-brand">
        <img id="logo" src="/astrumlogo.png" alt="" />
        <h1 class="nav-title">ASTRUM TECH</h1>
      </div>

      <button id="mobile-menu-button" class="mobile-menu-btn">
        <svg
          class="menu-icon"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <div class="nav-links desktop-nav">
        <a href="#inicio" class="nav-link">Servicios</a>
        <a href="#servicios" class="nav-link">Sobre nosotros</a>
        <a href="#proceso" class="nav-link">Clientes</a>
        <a href="#testimonios" class="nav-link">Contacto</a>
        <a href="#testimonios" class="nav-link">Testimonios</a>
        <div class="lang-selector">
          <button
            class="lang-toggle"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Cambiar idioma"
          >
            <img class="global-icon" src="/global.svg" alt="" />
          </button>
          <ul class="lang-dropdown">
          <li>
            <button class="lang-option" type="button" data-lang="es">
              <img class="lang-flag" src="/spain.webp" alt="Español" />
              <p class="lang-text">Spanish</p>
            </button>
          </li>
          <li>
            <button class="lang-option" type="button" data-lang="en">
              <img class="lang-flag" src="/england.webp" alt="English" />
              <p class="lang-text">English</p>
            </button>
          </li>
          </ul>
        </div>
      </div>
    </nav>
  </div>
  <div id="mobile-menu" class="mobile-nav">
    <div class="header-mobile-menu">
      <div class="nav-brand">
        <img id="logo" src="/astrumlogo.png" alt="" />
        <h1 class="nav-title">ASTRUM TECH</h1>
      </div>
      <button id="mobile-close" class="mobile-menu-btn-close">
        <svg
          class="menu-icon"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 6l12 12M6 18L18 6"
          >
          </path>
        </svg>
      </button>
    </div>
    <div class="mobile-nav-links">
      <a href="#inicio" class="mobile-nav-link">Inicio</a>
      <a href="#servicios" class="mobile-nav-link">Sobre nosotros</a>
      <a href="#proceso" class="mobile-nav-link">Clientes</a>
      <a href="#testimonios" class="mobile-nav-link">Contacto</a>
      <a href="#testimonios" class="mobile-nav-link">Testimonios</a>
      <div class="lang-selector">
        <button
          class="lang-toggle"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Cambiar idioma"
        >
          <img class="global-icon" src="/global.svg" alt="" />
        </button>
        <ul class="lang-dropdown">
          <li>
            <button class="lang-option" type="button" data-lang="es">
              <img class="lang-flag" src="/spain.webp" alt="Español" />
              <p class="lang-text">Spanish</p>
            </button>
          </li>
          <li>
            <button class="lang-option" type="button" data-lang="en">
              <img class="lang-flag" src="/england.webp" alt="English" />
              <p class="lang-text">English</p>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</header>

<script src="./Navbar.ts"></script>
