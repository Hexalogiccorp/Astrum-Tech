---
import './galleryStyle.css'

const images = [
  { src: "/galleryFeed1.jpg", alt: "Excavadora trabajando en obra" },
  { src: "/galleryFeed2.jpg", alt: "Piezas de mantenimiento sobre bandeja" },
  { src: "/galleryFeed6.jpg", alt: "Grúa perforadora en sitio", feature: true },
  { src: "/galleryFeed5.jpg", alt: "Servo drives industriales" },
  { src: "/galleryFeed4.jpg", alt: "Brazo robótico en laboratorio" },
  { src: "/galleryFeed3.jpg", alt: "Máquina con sensores" },
];
---
<section class="m-5 mx-5 md:mx-20">

    <div class="flex flex-col gap-5 items-center mb-5">
        <h2 class="title">Titulo de seccion</h2>
        <p class="paragraph">GALLERY ABOUT OR WORK</p>
    </div>

    <div class="gallery mt-10 md:mt-20">
        <div class="gallery-item">
            <img src={images[0].src} alt={images[0].alt} />
        </div>
        <div class="gallery-item">
            <img src={images[1].src} alt={images[1].alt} />
        </div>
        <div class="gallery-item">
            <img src={images[3].src} alt={images[3].alt} />
        </div>
        <div class="gallery-item">
            <img src={images[4].src} alt={images[4].alt} />
        </div>
        <div class="gallery-item">
            <img src={images[5].src} alt={images[5].alt} />
        </div>
        <a href="#" class="gallery-item gallery-item--feature">
            <img src={images[2].src} alt={images[2].alt} />
            <span class="gallery-item__label text-base">Watch gallery</span>
        </a>
    </div>

</section>

<script src="./Gallery.ts"></script>