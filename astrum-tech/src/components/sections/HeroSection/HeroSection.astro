---
import "./HeroSection.css";
import BaseButton from "../../BaseButton/BaseButton.astro";
const photos = ["/heroSectionPhoto.png","/test2.jpg"];
---

<section class="flex items-center hero-section">
  <div class="left-side relative z-10 space-y-4 sm:space-y-5 md:space-y-6 w-[65%] p-4 sm:p-8">
    <h1 class="title">
      LOREM IPSUM DOLOR <span class="text-(--primary-color)">SIT AMMET</span> INNET BUTER ITTAR
    </h1>
    <p class="paragraph">
      Lorem Ipsum dolor sit ammet surtur asator irtir surtur asator Lorem Ipsum
      dolor sit ammet surtur asator irtir surtur asator
    </p>

    <BaseButton
      >CONTACT US <svg
        width="29"
        height="29"
        viewBox="0 0 29 29"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g clip-path="url(#clip0_207_201)">
          <path
            d="M10.8749 6.04163V8.45829H18.8378L4.83325 22.4629L6.537 24.1666L20.5416 10.162V18.125H22.9583V6.04163H10.8749Z"
            fill="white"></path>
        </g>
        <defs>
          <clipPath id="clip0_207_201">
            <rect width="29" height="29" fill="white"></rect>
          </clipPath>
        </defs>
      </svg>
    </BaseButton>
  </div>

  <div class="right-side absolute inset-y-0 right-0 z-0 w-[45%] bg-(--primary-color) max-[480px]:w-[60%] max-[480px]:h-[38vh] md:block">
    <div class="hero-photo-frame" id="photo-frame">
      <div class="photo-slides relative w-full h-full">
        {photos.map((src, i) => (
          <img
            src={src}
            alt="Grúa de construcción en obra"
            class:list={["hero-photo-slide", { "is-active": i === 0 }]}
          />
        ))}
      </div>
    </div>

    <div class="hero-badge absolute inset-x-0 bottom-0 flex justify-end">
      <div class="hero-badge-number flex items-center justify-center self-start overflow-hidden font-bold" id="badge-number">
        <span class="hero-badge-number-value">01</span>
      </div>
      <div class="hero-badge-text flex items-center overflow-hidden max-w-[70%]">
        <p>
          Lorem Ipsum dolor sit ammet surtur asator irtir surtur asator Lorem
          Ipsum dolor sit ammet surtur asator irtir surtur asator
        </p>
      </div>
    </div>
  </div>
</section>

<script src="./HeroSection.ts"></script>
