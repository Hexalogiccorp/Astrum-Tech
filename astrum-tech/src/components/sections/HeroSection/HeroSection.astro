---
import "../../../styles/global.css";
import BaseButton from "../../BaseButton/BaseButton.astro";

const photos = ["/heroSectionPhoto.png","/test2.jpg"];
---

<section class="flex items-center hero-section">
  <div class="left-side space-y-4 sm:space-y-5 md:space-y-6 w-[80%] p-4 sm:p-8">
    <h1 class="title">
      LOREM IPSUM DOLOR <span class="highlight">SIT AMMET</span> INNET BUTER ITTAR
    </h1>
    <p class="paragraph">
      Lorem Ipsum dolor sit ammet surtur asator irtir surtur asator Lorem Ipsum
      dolor sit ammet surtur asator irtir surtur asator
    </p>

    <BaseButton
      >CONTACT US <svg
        width="29"
        height="29"
        viewBox="0 0 29 29"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g clip-path="url(#clip0_207_201)">
          <path
            d="M10.8749 6.04163V8.45829H18.8378L4.83325 22.4629L6.537 24.1666L20.5416 10.162V18.125H22.9583V6.04163H10.8749Z"
            fill="white"></path>
        </g>
        <defs>
          <clipPath id="clip0_207_201">
            <rect width="29" height="29" fill="white"></rect>
          </clipPath>
        </defs>
      </svg>
    </BaseButton>
  </div>

  <div class="right-side  md:block">
    <div class="photo-frame" id="photo-frame">
      <div class="photo-slides">
        {photos.map((src, i) => (
          <img
            src={src}
            alt="Grúa de construcción en obra"
            class:list={["photo-slide", { "is-active": i === 0 }]}
          />
        ))}
      </div>
    </div>

    <div class="badge">
      <div class="badge-number" id="badge-number">
        <span class="badge-number-value">01</span>
      </div>
      <div class="badge-text">
        <p>
          Lorem Ipsum dolor sit ammet surtur asator irtir surtur asator Lorem
          Ipsum dolor sit ammet surtur asator irtir surtur asator
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    height: 100vh;
  }

  @media (max-width: 1101px) {
    .hero-section {
      height: 70vh;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      height: 55vh;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      height: 40vh;
    }
  }

  .highlight {
    color: var(--primary-color);
  }

  .left-side {
    position: relative;
    z-index: 1;
  }

  .right-side {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 45%;
    background-color: var(--primary-color);
    z-index: 0;
  }

  .photo-frame {
    position: absolute;
    top: 9%;
    right: 45%;
    height: 78%;
    aspect-ratio: 1 / 1;
    background: var(--white-color);
    padding: 14px;
  }

  @media (max-width: 1366px) {
    .photo-frame {
      right: 40%;
    }
  }

  @media (max-width: 1101px) {
    .photo-frame {
      right: 42%;
    }
  }

  @media (max-width: 768px) {
    .photo-frame {
      right: 50%;
    }
  }

  .photo-slides {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .photo-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    clip-path: polygon(50% -50%, 150% 50%, 50% 150%, -50% 50%);
    z-index: 1;
  }

  .photo-slide.is-active {
    z-index: 2;
  }

  .photo-slide.is-leaving {
    animation: photo-frame-wipe-out 1.4s cubic-bezier(0.25, 1, 0.3, 1) forwards;
    z-index: 3;
  }

  @keyframes photo-frame-wipe-out {
    from {
      clip-path: polygon(50% -50%, 150% 50%, 50% 150%, -50% 50%);
    }
    to {
      clip-path: polygon(-50% 50%, 50% 150%, 50% 150%, -50% 50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-slide {
      animation: none !important;
      clip-path: polygon(50% -50%, 150% 50%, 50% 150%, -50% 50%);
    }
  }

  .badge {
    position: absolute;
    top: calc(9% + 78%);
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: flex-end;
  }

  .badge-number {
    align-self: flex-start;
    width: clamp(90px, 8vw, 180px);
    background: var(--white-color);
    color: var(--secondary-color);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(20px, 1.5vw + 12px, 60px);
    padding: 1rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-shadow: 0.1em 0 0 var(--primary-color);
    overflow: hidden;
  }

  .badge-number-value {
    display: inline-block;
  }

  .badge-number-value.is-animating {
    animation: badge-number-pop 0.4s ease;
  }

  @keyframes badge-number-pop {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-number-value.is-animating {
      animation: none;
    }
  }

  @media (max-width: 1366px) {
    .badge-number {
      font-size: clamp(16px, 1.2vw + 8px, 24px);
      padding: 0.75rem 1.25rem;
    }
  }

  @media (max-width: 1101px) {
    .badge-number {
      font-size: clamp(14px, 1vw + 6px, 20px);
      padding: 0.6rem 1rem;
    }
  }

  @media (max-width: 819px) {
    .badge-number {
      width: clamp(45px, 4vw, 70px);
      font-size: clamp(12px, 1vw + 5px, 16px);
      padding: 0.5rem 0.85rem;
      position: absolute;
      top: 0;
      right: 55%;
    }
  }

  @media (max-width: 819px) {
    .photo-frame {
      right: auto;
      left: -60%;
    }
  }

  .badge-text {
    background: var(--secondary-color);
    color: var(--white-color);
    padding: 1.88rem 1.25rem;
    max-width: 70%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .badge-text p {
    font-family: var(--font-sans);
    font-size: clamp(11px, 0.5vw + 9px, 40px);
    line-height: 1.4;
  }

  @media (max-width: 1366px) {
    .badge-text {
      padding: 1.25rem 1rem;
    }

    .badge-text p {
      font-size: clamp(10px, 0.5vw + 7px, 12px);
    }
  }

  @media (max-width: 1101px) {
    .badge-text {
      padding: 0.85rem 0.85rem;
    }

    .badge-text p {
      font-size: clamp(9px, 0.5vw + 6px, 11px);
    }
  }

  @media (max-width: 819px) {
    .badge-text {
      display: none;
      padding: 0.6rem 0.75rem;
    }

    .badge-text p {
      font-size: clamp(8px, 0.5vw + 5px, 10px);
    }
  }

  @media (max-width: 480px) {
    .right-side {
      width: 60%;
    }

    .photo-frame {
      right: auto;
      left: -14%;
    }
  }
</style>

<script>
  const frame = document.getElementById("photo-frame");

  if (frame) {
    const slides = Array.from(
      frame.querySelectorAll<HTMLElement>(".photo-slide")
    );

    const numberValue = document.querySelector<HTMLElement>(
      "#badge-number .badge-number-value"
    );

    function updateBadgeNumber(index: number) {
      if (!numberValue) {
        return;
      }

      numberValue.classList.remove("is-animating");
      void numberValue.offsetWidth;
      numberValue.textContent = String(index + 1).padStart(2, "0");
      numberValue.classList.add("is-animating");
    }

    let currentIndex = 0;
    let isAnimating = false;
    const autoAdvanceDelay = 5000;
    const leaveAnimationDuration = 1400;

    function goToSlide(nextIndex: number) {
      if (nextIndex === currentIndex || isAnimating) {
        return;
      }

      isAnimating = true;

      const current = slides[currentIndex];
      const next = slides[nextIndex];

      next.classList.add("is-active");
      current.classList.add("is-leaving");
      updateBadgeNumber(nextIndex);

      let fallbackTimer: ReturnType<typeof setTimeout>;

      function finishLeave() {
        current.removeEventListener("animationend", onLeaveEnd);
        clearTimeout(fallbackTimer);
        current.classList.remove("is-leaving", "is-active");
        isAnimating = false;
      }

      function onLeaveEnd(event: AnimationEvent) {
        if (event.target !== current) {
          return;
        }
        finishLeave();
      }

      current.addEventListener("animationend", onLeaveEnd);
      fallbackTimer = setTimeout(finishLeave, leaveAnimationDuration + 300);

      currentIndex = nextIndex;
    }

    function nextSlide() {
      goToSlide((currentIndex + 1) % slides.length);
    }

    if (slides.length > 1) {
      setInterval(nextSlide, autoAdvanceDelay);
    }
  }
</script>
